{
  "name": "bot-derby",
  "version": "2026.10.14",
  "private": true,
  "description": "Ferdi (Jev) vs Bodi (OpenAI Decisions), paper trading with a public read-only scoreboard",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@okx_ai/okx-trade-cli"
    ]
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/derby/index.ts",
    "start": "node dist/derby/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "universe": "tsx src/tools/universe.ts",
    "snapshot": "tsx src/tools/snapshot.ts",
    "parity": "tsx src/tools/parity-market.ts",
    "e2e:fake-jev": "tsx test/e2e-dry.harness.ts",
    "jev:check": "tsx --env-file-if-exists=.env src/tools/jev-check.ts",
    "effective-config": "tsx src/tools/effective-config.ts",
    "keycheck": "tsx --env-file-if-exists=.env src/tools/keycheck.ts",
    "demo:roundtrip": "tsx --env-file-if-exists=.env src/tools/demo-roundtrip.ts",
    "demo:close": "tsx --env-file-if-exists=.env src/tools/demo-close.ts",
    "derby": "tsx --env-file-if-exists=.env src/derby/index.ts",
    "derby:start": "node dist/derby/index.js",
    "legacy:dev": "DB_PATH=./data/bees-{mode}.sqlite tsx --env-file-if-exists=.env src/index.ts",
    "legacy:start": "node dist/index.js",
    "derby:check": "tsx --env-file-if-exists=.env src/derby/check.ts",
    "stocks:check": "tsx --env-file-if-exists=.env src/derby/stocks/check.ts"
  },
  "dependencies": {
    "@okx_ai/okx-trade-cli": "1.4.8",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
